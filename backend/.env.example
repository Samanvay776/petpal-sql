# PetPal Backend Environment Variables Example

# Server Port (Render sets this automatically)
PORT=5005

# Frontend Application URL for CORS configuration
# Example: https://petpal-sql.vercel.app
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (from Render Postgres or Neon/Supabase)
# If omitted, server falls back to local SQLite database (database.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Secret for Token Signing
JWT_SECRET=petpal_production_secret_key_change_me
